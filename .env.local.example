# Copy this file to .env.local for local development, and add the same
# three values in Vercel: Project Settings -> Environment Variables.
# Never put real values in THIS file — it's just a template that gets
# committed to git. Real values go in .env.local (gitignored) and Vercel.

# Supabase project settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any password you choose - this unlocks your tracker on a new device.
TRACKER_PASSPHRASE=choose-a-strong-passphrase
