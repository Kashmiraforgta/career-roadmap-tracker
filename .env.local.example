# Copy this file to .env.local for local development, and add the same
# three values in Vercel: Project Settings -> Environment Variables.

# Supabase project settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any password you choose - this is what unlocks your tracker on a new
# device. Pick something only you know; it is never sent to the browser
# in plain config, only typed in by you.
TRACKER_PASSPHRASE=choose-a-strong-passphrase
